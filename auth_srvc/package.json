{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "Authentication and User Management Service",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${AUTH_PORT:-3000} -H ${HOSTNAME:-0.0.0.0} --experimental-https --experimental-https-key ${KEY_PATH:-/certs/key.pem} --experimental-https-cert ${CERT_PATH:-/certs/cert.pem} --experimental-https-ca ${NODE_EXTRA_CA_CERTS:-/usr/local/share/ca-certificates/root_transcendence_ca.crt}",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.2.0",
    "@prisma/client": "7.2.0",
    "bcryptjs": "^3.0.3",
    "next": "^16.1.6",
    "next-auth": "^4.24.13",
    "pg": "^8.18.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^18",
    "dotenv": "^17.3.1",
    "prisma": "^7.2.0",
    "typescript": "^5"
  }
}

{
  "name": "transcendence-frontend",
  "version": "1.0.0",
  "description": "dashboard for game project",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${FRONTEND_PORT:-3003} -H ${HOSTNAME:-0.0.0.0} --experimental-https --experimental-https-key ${KEY_PATH:-/certs/key.pem} --experimental-https-cert ${CERT_PATH:-/certs/cert.pem} --experimental-https-ca ${NODE_EXTRA_CA_CERTS:-/usr/local/share/ca-certificates/root_transcendence_ca.crt}",
    "build": "next build",
    "start": "next start -p ${FRONTEND_PORT:-3003}",
    "lint": "next lint"
  },
  "dependencies": {
    "autoprefixer": "^10.4.0",
    "axios": "^1.6.0",
    "next": "^14.2.35",
    "postcss": "^8.4.0",
    "postprocessing": "^6.39.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@types/node": "^25.2.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

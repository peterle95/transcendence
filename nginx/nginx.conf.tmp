load_module	"/usr/lib/nginx/modules/ngx_http_coraza_module.so";


error_log	stderr	${NGINX_LOG_LEVEL};

worker_processes	auto;

pid		/tmp/nginx.pid;

events {
	worker_connections 1024;
}

http {
	resolver	127.0.0.11	ipv6=off;

	coraza		on;
	http2		on;
	http3		on;

	server_tokens	off;

	coraza_rules '
		SecRuleEngine On
		SecDebugLogLevel ${WAF_LOG_LEVEL}
		SecDebugLog /dev/stderr
		SecAuditLog /dev/stdout
		SecRequestBodyAccess On
		SecAuditLogFormat Native
		SecRequestBodyLimit 13107200
		SecRequestBodyNoFilesLimit 131072
		SecRequestBodyJsonDepthLimit 512
		SecResponseBodyAccess On
		SecArgumentsLimit 1000
		SecResponseBodyLimit 524288
		SecResponseBodyLimitAction ProcessPartial
		SecAuditEngine RelevantOnly
		SecAuditLogParts ABIJDEFHZ
		SecAuditLogType Serial
		SecAuditLogRelevantStatus "^(?:5|4[0-9][0-35-9])"
		SecTmpDir /tmp/
		SecDataDir /tmp/

		SecRule REQUEST_HEADERS:Content-Type \
			"^(?:application(?:/soap\+|/)|text/)xml" \
			"id:\'200000\',phase:1,t:none,t:lowercase,pass,nolog,\
			ctl:requestBodyProcessor=XML"

		SecRule REQUEST_HEADERS:Content-Type \
			"^application/json" \
			"id:\'200001\',phase:1,t:none,t:lowercase,pass,nolog,\
			ctl:requestBodyProcessor=JSON"

		SecRule &ARGS "@ge 1000" \
			"id:\'200007\', phase:2,t:none,log,deny,status:400,msg:\
			\'Failed to fully parse request body due to large argument \
			count\',severity:2"
	';

	coraza_rules_file /opt/coraza/config/crs-setup.conf;
	coraza_rules_file /opt/coraza/owasp-crs/plugins/*-config.conf;
	coraza_rules_file /opt/coraza/owasp-crs/plugins/*-before.conf;
	coraza_rules_file /opt/coraza/owasp-crs/rules/*.conf;
	coraza_rules_file /opt/coraza/owasp-crs/plugins/*-after.conf;

	access_log	stdout;

	proxy_ssl_server_name		on;
	proxy_ssl_verify		on;
	proxy_ssl_verify_depth		2;
	proxy_ssl_protocols		TLSv1.3;
	proxy_ssl_certificate    	${CERT_PATH};
	proxy_ssl_certificate_key	${KEY_PATH};
	proxy_ssl_trusted_certificate	${ROOTCERT};
	proxy_ssl_session_reuse		on;

	proxy_set_header	Host			#host;
	proxy_set_header	X-Real-IP		#remote_addr;
	proxy_set_header	X-Forwarded-For		#proxy_add_x_forwarded_for;
	proxy_set_header	X-Forwarded-Proto	#scheme;
	proxy_set_header	X-Forwarded-Host	#host;
	proxy_set_header	Cookie			#http_cookie;
	proxy_set_header        Upgrade                 #http_upgrade;
	proxy_set_header        Connection              "upgrade";
	proxy_http_version	1.1;

	add_header		X-Frame-Options			SAMEORIGIN;
	add_header		X-Content-Type-Options		nosniff;
	add_header		X-XSS-Protection		"1; mode=block";
	add_header		Strict-Transport-Security	"max-age=31536000; includeSubdomains; preload";
	${ADD_HEADER}		${ONION_LOCATION}		${ONION_ADDRESS_MAIN_HEADER}${REQUEST_URI}



	server	{
		listen			${NGINX_TCP};
		server_name		${DOMAIN} ${ONION_ADDRESS_MAIN};
		return	301		${HTTP}#host#request_uri;
	}

	ssl_client_certificate		${ROOTCERT};
	ssl_protocols			TLSv1.3;
	ssl_prefer_server_ciphers	on;
	ssl_session_cache		shared:SSL:50m;
	ssl_session_timeout		1d;
	ssl_session_tickets		off;
	ssl_ciphers			ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384;

	server {
		listen		${NGINX_TLS}	ssl;
		listen		${NGINX_UDP}	quic		reuseport;

		server_name			${DOMAIN} ${ONION_ADDRESS_MAIN};
		ssl_certificate    		${MAIN_CERT_PATH};
		ssl_certificate_key		${MAIN_KEY_PATH};

		client_max_body_size		10M;

		location ~ ^/_next/(webpack-hmr|.*\.js)$	{
			proxy_pass		${HTTP}frontend.${PROJECT_NAME}-${SERVICE_NAMESPACE}:${FRONTEND_PORT};
			coraza			off;
		}

		location /	{
			proxy_pass		${HTTP}frontend.${PROJECT_NAME}-${SERVICE_NAMESPACE}:${FRONTEND_PORT};
		}

		location ${AUTH_PATH}	{
			proxy_pass		${HTTP}auth.${PROJECT_NAME}-${SERVICE_NAMESPACE}:${AUTH_PORT};
			coraza_rules		'SecRuleRemoveByID 911100';
		}

		location ~ ^(${CHAT_WS_PATH}|${CHAT_PATH}/_next/.*\.js$) {
			proxy_pass		${HTTP}chat.${PROJECT_NAME}-${SERVICE_NAMESPACE}:${CHAT_PORT};
			proxy_read_timeout	86400s;
			proxy_send_timeout	86400s;
			coraza			off;
		}

		location ${CHAT_PATH}	{
			proxy_pass		${HTTP}chat.${PROJECT_NAME}-${SERVICE_NAMESPACE}:${CHAT_PORT};
		}

		location ~ ^${GAME_WS_PATH}	{
			proxy_pass		${HTTP}game.${PROJECT_NAME}-${SERVICE_NAMESPACE}:${SOCKET_PORT};
			proxy_read_timeout	86400s;
			proxy_send_timeout	86400s;
			coraza			off;
		}

		location ~ ^(${GAME_PATH}|/api/auth/me|/assets/)	{
			rewrite ^/assets/(.*)	${GAME_PATH}/assets/#1 break;
			proxy_pass		${HTTP}game.${PROJECT_NAME}-${SERVICE_NAMESPACE}:${GAME_PORT};
			${ADD_HEADER}		${ONION_LOCATION}	${ONION_ADDRESS_VAULT_HEADER}${REQUEST_URI}
		}
	}

	server {
		listen			1337		ssl;
		listen			1337		quic		reuseport;

		server_name ${HOSTNAME};
		ssl_certificate    		${CERT_PATH};
		ssl_certificate_key		${KEY_PATH};

		coraza			off;

		location = /healthcheck {
			access_log	off;
			return		200		'OK';
		}
	}
}

load_module	"/usr/lib/nginx/modules/ngx_http_coraza_module.so";
load_module	"/usr/lib/nginx/modules/ngx_http_geoip_module${NGINX_MODULE}.so";
load_module	"/usr/lib/nginx/modules/ngx_http_js_module${NGINX_MODULE}.so";
load_module	"/usr/lib/nginx/modules/ngx_http_xslt_filter_module${NGINX_MODULE}.so";
load_module	"/usr/lib/nginx/modules/ngx_http_image_filter_module${NGINX_MODULE}.so";
load_module	"/usr/lib/nginx/modules/ngx_stream_geoip_module${NGINX_MODULE}.so";
load_module	"/usr/lib/nginx/modules/ngx_stream_js_module${NGINX_MODULE}.so";


error_log	stderr	${NGINX_LOG_LEVEL};

worker_processes	auto;

pid		/tmp/nginx.pid;

events {
	worker_connections 1024;
}

http {
	resolver	127.0.0.11	ipv6=off;

	coraza		on;
	http2		on;
	http3		on;

	server_tokens	off;

	coraza_rules '
		SecRuleEngine On
		SecDebugLogLevel ${WAF_LOG_LEVEL}
		SecRequestBodyAccess On
		SecAuditLogFormat Native
		SecRequestBodyLimit 13107200
		SecRequestBodyNoFilesLimit 131072
		SecRequestBodyJsonDepthLimit 512
		SecResponseBodyAccess On
		SecArgumentsLimit 1000
		SecResponseBodyLimit 524288
		SecResponseBodyLimitAction ProcessPartial
		SecAuditEngine On
		SecAuditLogParts ABIJDEFHZ
		SecAuditLogType Serial
		SecAuditLogRelevantStatus "^(?:5|4[0-9][0-35-9])"
		SecTmpDir /tmp/
		SecDataDir /tmp/

		SecRule REQUEST_HEADERS:Content-Type \
			"^(?:application(?:/soap\+|/)|text/)xml" \
			"id:\'200000\',phase:1,t:none,t:lowercase,pass,nolog,\
			ctl:requestBodyProcessor=XML"

		SecRule REQUEST_HEADERS:Content-Type \
			"^application/json" \
			"id:\'200001\',phase:1,t:none,t:lowercase,pass,nolog,\
			ctl:requestBodyProcessor=JSON"

		SecRule &ARGS "@ge 1000" \
		    "id:\'200007\', phase:2,t:none,log,deny,status:400,msg:\
		    \'Failed to fully parse request body due to large argument \
		    count\',severity:2"
	';

	coraza_rules_file /opt/coraza/config/crs-setup.conf;
	coraza_rules_file /opt/coraza/owasp-crs/plugins/*-config.conf;
	coraza_rules_file /opt/coraza/owasp-crs/plugins/*-before.conf;
	coraza_rules_file /opt/coraza/owasp-crs/rules/*.conf;
	coraza_rules_file /opt/coraza/owasp-crs/plugins/*-after.conf;

	access_log	stdout;

	proxy_ssl_server_name		on;
	proxy_ssl_protocols		TLSv1.3;
	proxy_ssl_certificate    	${CERT_PATH};
	proxy_ssl_certificate_key	${KEY_PATH};
	proxy_ssl_trusted_certificate	${ROOTCERT};
	proxy_ssl_session_reuse		on;

	proxy_set_header	Host			@host;
	proxy_set_header	X-Real-IP		@remote_addr;
	proxy_set_header	X-Forwarded-For		@proxy_add_x_forwarded_for;
	proxy_set_header	X-Forwarded-Proto	@scheme;
	proxy_set_header	X-Forwarded-Host	@host;
	proxy_set_header	Cookie			@http_cookie;
	${ADD_HEADER}		${ONION_LOCATION}	${ONION_ADDRESS_MAIN_HEADER}${REQUEST_URI}

	upstream	frontend	{
		server frontend.${PROJECT_NAME}-${SERVICE_NAMESPACE}:${FRONTEND_PORT};
	}
	upstream	auth		{
		server auth.${PROJECT_NAME}-${SERVICE_NAMESPACE}:${AUTH_PORT};
	}
	upstream	chat		{
		server chat.${PROJECT_NAME}-${SERVICE_NAMESPACE}:${CHAT_PORT};
	}
	upstream	game		{
		server game.${PROJECT_NAME}-${SERVICE_NAMESPACE}:${GAME_PORT};
	}
	upstream	game_ws		{
		server game.${PROJECT_NAME}-${SERVICE_NAMESPACE}:${SOCKET_PORT};
	}


	server	{
		listen		${NGINX_TCP};
		server_name			${DOMAIN};

		return		301		${HTTP}@host@request_uri;
	}

	ssl_client_certificate		${ROOTCERT};
	ssl_protocols			TLSv1.2 TLSv1.3;

	server {
		listen		${NGINX_TLS}	ssl;
		listen		${NGINX_UDP}	quic		reuseport;

		server_name			${DOMAIN};
		ssl_certificate    		${MAIN_CERT_PATH};
		ssl_certificate_key		${MAIN_KEY_PATH};

		client_max_body_size		10M;

		$using_at_because_envsubst_will_remove_all_strings
		$that_start_with_a_dollarsign_and_arent_an_env_keyword
		$using_sed_after_envsubst_to_change_at_back_to_dollarsigns

		location /assets/ {
			rewrite ^/assets/(.*) ${GAME_PATH}/assets/@1 break;
			proxy_pass ${HTTP}game;
			proxy_hide_header Cookie;
		}

		location = /api/auth/me {
			proxy_pass ${HTTP}game${GAME_PATH}/api/auth/me;
		}

		location / {
			proxy_pass ${HTTP}frontend;
			proxy_hide_header Cookie;
			coraza	off;
		}

		location ${AUTH_PATH} {
			proxy_pass ${HTTP}auth;
			coraza	off;
		}

		location ${CHAT_PATH} {
			proxy_pass ${HTTP}chat;
			coraza	off;
		}

		location ${CHAT_WS_PATH} {
			proxy_pass ${HTTP}chat;
			proxy_http_version	1.1;
			proxy_set_header	Host			@host;
			proxy_set_header	X-Real-IP		@remote_addr;
			proxy_set_header	X-Forwarded-For		@proxy_add_x_forwarded_for;
			proxy_set_header	X-Forwarded-Proto	@scheme;
			proxy_set_header	X-Forwarded-Host	@host;
			proxy_set_header	Cookie			@http_cookie;
			proxy_set_header	Upgrade			@http_upgrade;
			proxy_set_header	Connection		"upgrade";
			proxy_read_timeout	86400s;
			proxy_send_timeout	86400s;
			coraza off;
		}

		location ${GAME_PATH} {
			proxy_pass ${HTTP}game;
			${ADD_HEADER} ${ONION_LOCATION} ${ONION_ADDRESS_VAULT_HEADER}${REQUEST_URI}
		}

		location ${GAME_WS_PATH} {
			proxy_pass ${HTTP}game_ws;
			proxy_http_version	1.1;
			proxy_set_header	Upgrade			@http_upgrade;
			proxy_set_header	Host			@host;
			proxy_set_header	X-Real-IP		@remote_addr;
			proxy_set_header	X-Forwarded-For		@proxy_add_x_forwarded_for;
			proxy_set_header	X-Forwarded-Proto	@scheme;
			proxy_set_header	X-Forwarded-Host	@host;
			proxy_set_header	Cookie			@http_cookie;
			proxy_set_header	Connection		"upgrade";
			proxy_read_timeout	86400s;
			proxy_send_timeout	86400s;
		}
	}

	server {
		listen			1337		ssl;
		listen			1337		quic		reuseport;

		server_name ${HOSTNAME};
		ssl_certificate    		${CERT_PATH};
		ssl_certificate_key		${KEY_PATH};

		location = /healthcheck {
			access_log	off;
			return		200		'OK';
		}
	}
}

#					#	#
SERVICE_NAMESPACE=backend
DATABASE_NAMESPACE=db
REV_PROXY_NAMESPACE=proxy
VAULT_NAMESPACE=thesecret
AI_NAMESPACE=bot
#					#	#
VAULT_CODENAME=heute-nicht
NGINX_CODENAME=clear
TOR_CODENAME=dark
#					#	#
#########################################	#
##						#
##						#
###	URL NAMING SCHEME	#########	#
#					#	#
HTTP=https://
DOMAIN=localhost
#					#	#
CHAT_PATH=/chat
CHAT_WS_PATH=/socket.io
GAME_PATH=/game
GAME_WS_PATH=/socket.io
AUTH_PATH=/auth
#					#	#
#########################################	#
##						#

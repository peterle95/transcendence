#					#	#
GAME_DB=game_db
AUTH_DB=auth_db
#					#	#
#########################################	#
###	END NAMING SCHEMES	#################




#########	NETWORKING		#################################
#									#
######	INTERNAL NETWORKING	#########				#
##					#				#
###	PORTS	#################	#				#
#				#	#				#
VAULT_PORT=4545
#				#	#				#
POSTGRES_PORT=4534
MONGO_PORT=4532
#				#	#				#
AUTH_PORT=844
#				#	#				#
CHAT_PORT=487
#				#	#				#
GAME_PORT=666
SOCKET_PORT=2000
#				#	#				#
FRONTEND_PORT=443
#				#	#				#
#################################	#				#
##					#				#
##					#				#
###	SUBNETS		#########	#				#
#				#	#				#
SERVICE_SUBNET=ip/28
#				#	#				#
PROXY_SUBNET=ip/29
#				#
VAULT_PROXY_IP=ip
NGINX_PROXY_IP=ip
TOR_PROXY_IP=ip
#				#	#				#
#				#	#				#
AI_SUBNET=ip/29
#				#	#				#
# ^^^^^	IF YOU CHANGE SUBNETS	#	#				#
#	  YOU WILL HAVE TO	#	#				#
#	CHANGE IPS ACCORDINGLY	#	#				#
##				#	#				#
#################################	#				#
######	END INTERNAL NETWORKING	#########				#
###									#
###									#
#################################################			#
######		EXTERNAL NETWORKING		#########################
##									#
###	TOR CONFIG	#########################################	#
#								#	#
COMPOSE_PROFILES=the_hidden_service
# 		^^^^^^^^					#	#
#	>>> UNCOMMENT FOR ACCESS OVER ONION ROUTER <<< 		#	#
#	TELL YOUR SERVER THAT YOU ARE NOT ON LOCALHOST		#	#
#	 LINES BELOW GENERATE HIDDENSERVICE V3 VANITY		#	#
#	 ADDRESSES ---  KEEP IT ONE CHARACTER FOR DEV		#	#
#       >>>   ADDRESSES ARE ADVERTISED OVER ONION-   <<<	#	#
#	 LOCATION HEADER WHEN ACCESSED OVER NGINX PROXY
#								#	#
VANITY_ADDRESS_VAULT=vaultthatisunderratted
VANITY_ADDRESS_MAIN=address
#								#	#
HIDDEN_SERVICE_PORT=9250:9250
# ^^^^^	EXTERNAL PORT FOR ONION	ROUTER				#	#
#								#	#
###	END TOR CONFIG	#########################################	#
##									#
##									#
###	NGINX CONFIG	#########################################	#
#								#	#
NGINX_TCP=90:90
# ^^^^^	TCP >>>	USED TO REDIRECT TO 443	<<<			#	#
#								#	#
NGINX_TLS=444:444/tcp
# ^^^^^	TLS >>>	RUNNING HTTP2 + TLSv1.3	<<<			#	#
#								#	#
NGINX_UDP=444:444/udp
# ^^^^^	UDP >>>	RUNNING HTTP3 + TLSv1.3	<<<			#	#
#								#	#
LOCAL=10
# ^^^^^	>>>	EXTERNAL PORT	<<<				#	#
#	REMOVE FOR LISTENING ON ALL				#	#
#	>>>	INTERFACES	<<<				#	#
#								#	#
###	END NGINX	#########################################	#
##									#
##									#
###	WAF CONFIG	#########################################	#
#								#	#
PARANOIA=1
ANOMALY_INBOUND=4
ANOMALY_OUTBOUND=2
BLOCKING_PARANOIA=4
#								#	#
#######		END EXTERNAL NETWORKING		#########################
############		END NETWORKING			#################




######		SERVICE CONFIGS		#################
#							#
###	GAME CONFIG	#########################	#
#						#	#
REMOTE_MULTIPLAYER_ENABLED=true
##						#	#
##						#	#
###	AI CONFIG	#########################	#
#						#	#
ROOM_ID=gameplay-room
MODEL_PATH=/app/models/live/dqn_latest.pt
LOAD_AI_MODELS=true
MODEL_AUTO_RELOAD=true
MODEL_RELOAD_INTERVAL_S=5
TRAINING_MODE=false
ENABLE_TRAINING_ROOM=false
AI_AMOUNT=3
#						#	#
##						#	#
##						#	#
###	POSTGRES CONFIG		#################	#
#						#	#
POSTGRES_DATA_DIR=/var/lib/postgresql/data
POSTGRES_HOST_AUTH_METHOD=certificate
PGSSLMODE=mode
##						#	#
##						#	#
###	VAULT CONFIG	#########################	#
#						#	#
DOMAIN_SSL_SECURITY=HIGH
#	^^^^^					#	#
#  POSSIBLE VALUES FOR ABOVE			#	#
#   >>>	LOW/MEDIUM/HIGH	<<<			#	#
#   ADJUST IF PKI TIMES OUT			#	#
#						#	#
MLOCK_ENABLED=0
CACHE_ENABLED=0
SAVE_KEY=0
EXPORT_KEY=
##						#	#
##						#	#
###	TOR CONFIG	#########################	#
#						#	#
TOR_DATA_DIR=/var/lib/tor
#################################################	#
######	END SERVICE CONFIGS	#########################



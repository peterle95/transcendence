# Copy this file to .env (git-ignored) and fill in real values.
# The .env file must be in the project root (next to docker-compose.yml).

# PostgreSQL superuser credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Connection strings (use the credentials above)
AUTH_DATABASE_URL=postgresql://postgres:change_me@postgres:5432/auth_db
GAME_DATABASE_URL=postgresql://postgres:change_me@postgres:5432/game_db

# NextAuth secret — generate with: openssl rand -hex 32
AUTH_SECRET=change_me

# Shared secret for inter-service calls (game_srvc → auth_srvc stats endpoint)
INTERNAL_SERVICE_SECRET=change_me

PUBLIC_URL=http://spacesupremacy.duckdns.org

# Internal URL for chat_srvc / game_srvc → auth_srvc (Docker DNS). Must include Next.js basePath `/auth`.
# docker-compose sets this; only override if you run services outside Compose.
# AUTH_SERVICE_URL=http://auth_srvc:3000/auth
